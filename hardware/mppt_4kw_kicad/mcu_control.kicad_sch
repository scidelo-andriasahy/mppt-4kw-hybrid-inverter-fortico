  (text_box "======================================\n  AFFECTATION DES BROCHES - STM32G4\n======================================\n--- MESURES (ADC) ---\nPA0  : V_PV_SENSE  (Tension Solaire)\nPA1  : I_PV_SENSE  (Courant Solaire)\nPA2  : V_BAT_SENSE (Tension Batterie)\nPA3  : I_BAT_SENSE (Courant Batterie)\nPA4  : TEMP_NTC    (Sonde Température)\n\n--- COMMANDE PUISSANCE (PWM TIM1) ---\nPA8  : PWM_PH1_HS  (Phase 1 - Haut)\nPB13 : PWM_PH1_LS  (Phase 1 - Bas)\nPA9  : PWM_PH2_HS  (Phase 2 - Haut)\nPB14 : PWM_PH2_LS  (Phase 2 - Bas)\nPA10 : PWM_PH3_HS  (Phase 3 - Haut)\nPB15 : PWM_PH3_LS  (Phase 3 - Bas)\n\n--- PROGRAMMATION & SYSTÈME ---\nPA13 : SWDIO       (Data SWD)\nPA14 : SWCLK       (Horloge SWD)\nPG10 : NRST        (Reset)\nP94  : BOOT0       (10k vers GND)\n\n--- Communication UART ---\nport USART3\nPB10 : TX        \nPB11 : RX        \n======================================"
    (at 213.614 15.748 0) (size 68.072 62.23)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid 0c781165-684a-47b3-bbc6-362f29a97616)
  )

