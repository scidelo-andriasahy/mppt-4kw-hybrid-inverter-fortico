  (rectangle (start 13.208 17.272) (end 66.548 79.248)
    (stroke (width 0) (type default))
    (fill (type none))
    (uuid d7c65a76-1117-49d3-a1ac-852bde0eec11)
  )

  (text_box "=========================================\nLEXIQUE & COMPOSANTS CLÉS DU PROJET\n\n--- 1. ABRÉVIATIONS ESSENTIELLES ---\nMPPT : Maximum Power Point Tracking (Algo d'optimisation solaire)\nPWM  : Pulse Width Modulation (Signal de commande du hacheur)\nADC  : Analog to Digital Converter (Lecture analogique des sondes)\nHS/LS: High-Side (Haut) / Low-Side (Bas) désignant les MOSFETs\nESR  : Equivalent Series Resistance (Résistance interne d'un condensateur)\nNTC  : Negative Temperature Coefficient (Sonde thermique de sécurité)\nSWD  : Serial Wire Debug (Port de programmation du microcontrôleur)\n\n--- 2. RÔLE DES COMPOSANTS PHYSIQUES ---\nSTM32G474 (MCU)  : \"Le Cerveau\". Calcule le MPPT et génère les signaux PWM.\nUCC21520 (Driver): \"Le Muscle\". Isole le MCU et amplifie le PWM en 12V.\nMOSFET (NMOS)    : \"L'Interrupteur\". Hache la puissance à 50 000 fois/sec.\nACS758 (Hall)    : \"Les Yeux\". Mesure les 180A sans contact (magnétique).\nInductance (L)   : \"Le Volant d'inertie\". Lisse le courant dans chaque phase.\nC_ELEC (Low-ESR) : \"Le Gros Réservoir\". Lisse la tension pour la batterie.\nC_CERA (X7R)     : \"L'Éponge Rapide\". Absorbe les parasites haute fréquence."
    (at 189.992 14.478 0) (size 92.456 44.45)
    (stroke (width 0) (type default))
    (fill (type none))
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid c25939c9-447e-48b8-add6-0376d2e9c97e)
  )

